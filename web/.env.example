# Server-only settings. Do not put a service-role key in the browser.
FINRAG_BACKEND_URL=
FINRAG_BACKEND_TOKEN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Fallback name for an existing Supabase project with legacy anon keys:
SUPABASE_ANON_KEY=

# Set true only after exact production redirects and email delivery are verified.
SUPABASE_AUTH_READY=false

# Local development only; production always requires an HTTPS backend.
FINRAG_ALLOW_LOOPBACK_HTTP=false
# Overall backend answer deadline (1,000 to 240,000 ms). Health uses 5 seconds.
FINRAG_BACKEND_TIMEOUT_MS=240000
