# FinRAG Environment Variables Example
# Copy this file to .env and insert your personal API keys

# Gemini API Key (Fallback and automated evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# MLflow Tracking URI (Default local: ./mlruns)
MLFLOW_TRACKING_URI=./mlruns
