# Frozen JSON manifests contain hashes of exact UTF-8/LF file bytes.
# Make Windows clones and git archive use the same canonical text bytes.
* text=auto
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary

# Web and SQL release hashes use canonical LF bytes on every platform.
web/** text eol=lf
web/public/fonts/*.woff2 binary
supabase/*.sql text eol=lf
supabase/migrations/*.sql text eol=lf
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.woff2 -text
*.pdf -text
*.docx -text
*.pptx -text
*.zip -text
